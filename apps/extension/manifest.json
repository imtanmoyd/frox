{
  "manifest_version": 3,
  "name": "Frox AI Assistant",
  "version": "0.1.0",
  "description": "A reusable, voice-first AI assistant that lives in your browser.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Frox AI Assistant",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "push-to-talk": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open voice mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"],
      "run_at": "document_idle"
    }
  ]
}
