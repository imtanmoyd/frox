{
  "name": "frox-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/extension",
    "apps/web"
  ],
  "scripts": {
    "dev": "vite --config apps/extension/vite.config.ts",
    "build": "vite build --config apps/extension/vite.config.ts",
    "dev:extension": "vite --config apps/extension/vite.config.ts",
    "build:extension": "vite build --config apps/extension/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.32",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
