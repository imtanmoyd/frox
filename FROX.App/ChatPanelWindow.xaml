<Window x:Class="FROX.App.ChatPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROX Chat"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#101418"
        Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#1b242d"
                CornerRadius="10"
                Padding="12">
            <TextBox x:Name="PromptBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0" />
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Width="120"
                    Height="32"
                    Content="Send"
                    Click="SendButton_Click" />
        </StackPanel>
    </Grid>
</Window>
