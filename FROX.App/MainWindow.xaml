<Window x:Class="FROX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FROX"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#101214"
        Foreground="#F4F4F5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22252A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#181A1F" BorderBrush="#292C32" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FROX"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Margin="10,8,10,28"/>
                    <Button Content="+  New conversation" Click="NewConversation_Click"/>
                    <TextBlock Text="WORKSPACE"
                               Foreground="#666A73"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="14,28,10,8"/>
                    <Button Content="Chat" Click="Chat_Click"/>
                    <Button Content="Companion" Click="Companion_Click"/>
                    <Button Content="Activity" Click="Activity_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Settings" Click="Settings_Click"/>
                    <TextBlock Text="Offline-first companion"
                               Foreground="#666A73"
                               FontSize="11"
                               Margin="14,16,10,4"/>
                    <TextBlock Text="Panda is ready"
                               Foreground="#7ED9A5"
                               FontSize="12"
                               Margin="14,0,10,8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,32,42,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock x:Name="PageTitle"
                           Text="Chat"
                           FontSize="20"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="Local and private"
                           Foreground="#858994"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <StackPanel x:Name="ChatView"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="600">
                <TextBlock x:Name="WelcomeTitle"
                           Text="What would you like to focus on?"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="WelcomeText"
                           Text="FROX is offline-ready. Ask for a focus plan, a reset, or a quick check-in."
                           Foreground="#92959F"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer x:Name="SettingsView"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="620">
                    <TextBlock Text="Connection"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Provider"
                               Foreground="#D4D4D8"
                               Margin="0,8,0,4"/>
                    <ComboBox x:Name="ProviderBox"
                              SelectedValuePath="Content"
                              SelectedValue="Offline"
                              SelectionChanged="ProviderBox_SelectionChanged"
                              Background="#1B1E23"
                              Foreground="#202124">
                        <ComboBoxItem Content="Offline"/>
                        <ComboBoxItem Content="OpenRouter"/>
                    </ComboBox>
                    <TextBlock Text="OpenRouter API key (kept in memory for this session)"
                               Foreground="#D4D4D8"
                               Margin="0,14,0,4"/>
                    <PasswordBox x:Name="ApiKeyBox"
                                 Background="#1B1E23"
                                 Foreground="White"
                                 Padding="10,8"/>
                    <TextBlock Text="Model"
                               Foreground="#D4D4D8"
                               Margin="0,14,0,4"/>
                    <TextBox x:Name="ModelBox"
                             Text="openai/gpt-4o-mini"
                             Background="#1B1E23"
                             Foreground="White"
                             BorderBrush="#343840"
                             Padding="10,8"/>
                    <Button Content="Save connection settings"
                            Width="210"
                            Margin="0,18,0,0"
                            HorizontalContentAlignment="Center"
                            Click="SaveSettings_Click"/>
                    <TextBlock x:Name="SettingsStatus"
                               Foreground="#7ED9A5"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="For safety, FROX never writes your API key to Git, source files, or the settings file. Rotate any key shared in chat."
                               Foreground="#858994"
                               TextWrapping="Wrap"
                               Margin="0,24,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    x:Name="Composer"
                    Background="#1B1E23"
                    BorderBrush="#343840"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,10">
                <DockPanel>
                    <Button Content="Send"
                            DockPanel.Dock="Right"
                            Width="70"
                            HorizontalContentAlignment="Center"
                            Click="Send_Click"/>
                    <TextBox x:Name="MessageBox"
                             Text="Ask FROX anything..."
                             Background="Transparent"
                             Foreground="#A1A1AA"
                             BorderThickness="0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             KeyDown="MessageBox_KeyDown"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
