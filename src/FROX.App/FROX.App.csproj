<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Run as x64 so RID-specific native assets (e_sqlite3.dll) are copied to output. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Build directly into the repo root so FROX.App.exe lives at D:\Projects\frox\FROX -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FROX.Core\FROX.Core.csproj" />
    <ProjectReference Include="..\FROX.Characters\FROX.Characters.csproj" />
    <ProjectReference Include="..\FROX.Brain\FROX.Brain.csproj" />
    <ProjectReference Include="..\FROX.Config\FROX.Config.csproj" />
    <ProjectReference Include="..\FROX.Data\FROX.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="FROX.ico" />
    <Resource Include="Assets\FroxLogo.png" />
  </ItemGroup>

</Project>
